<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>UsbDocumentBackup</AssemblyName>
    <RootNamespace>UsbDocumentBackup</RootNamespace>
    <ApplicationIcon />
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <!--
      Microsoft.Data.Sqlite 10.0.0 still pulls SQLitePCLRaw 2.1.x, whose bundled SQLite build has a
      known high-severity advisory (GHSA-2m69-gcr7-jv3q). Pinning the 3.x bundle directly overrides
      the transitive reference with a patched native SQLite.
    -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!-- OAuth only. Drive calls are made directly over REST so the resumable upload session can be
         persisted and resumed after a restart, which the client library does not expose. -->
    <PackageReference Include="Google.Apis.Auth" Version="1.76.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UsbDocumentBackup.Tests" />
  </ItemGroup>

</Project>
